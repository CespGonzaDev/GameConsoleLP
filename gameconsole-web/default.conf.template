# Server block de la consola web. Variables sustituidas por envsubst al arrancar:
#   GAMESTATS_UPSTREAM  host:puerto de la ingestión Go de GameStats (def. ingestion-go:8080)
#   PROLOG_UPSTREAM     host:puerto del microservicio Prolog       (def. prolog-ai-service:5000)
#
# Los upstreams se resuelven EN CADA PETICIÓN (resolver de Docker + variable en proxy_pass),
# así nginx arranca aunque GameStats o Prolog estén apagados (no más "host not found in upstream")
# y el frontend recibe un 503 JSON limpio, igual que el proxy de Vite en desarrollo.

resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Frontend SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache de assets inmutables de Vite
    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|ttf|svg)$ {
        expires 6M;
        access_log off;
        add_header Cache-Control "public, max-age=15552000, immutable";
    }

    # GameStats Ingestion (Go): /api/gamestats/events -> /events, /stats, /matches, /invalid, /health ...
    location /api/gamestats/ {
        set $gamestats_upstream ${GAMESTATS_UPSTREAM};
        rewrite ^/api/gamestats/(.*)$ /$1 break;
        proxy_pass http://$gamestats_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        client_max_body_size 32m;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;

        error_page 502 503 504 = @gamestats_offline;
    }

    # Prolog AI: /api/ai/health -> /health ; /api/ai/battleship/next-move se reenvía intacto
    location = /api/ai/health {
        set $prolog_upstream ${PROLOG_UPSTREAM};
        rewrite ^ /health break;
        proxy_pass http://$prolog_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;

        error_page 502 503 504 = @prolog_offline;
    }

    location /api/ai/ {
        set $prolog_upstream ${PROLOG_UPSTREAM};
        proxy_pass http://$prolog_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;

        error_page 502 503 504 = @prolog_offline;
    }

    location @gamestats_offline {
        default_type application/json;
        return 503 '{"error":"GameStats offline","status":"offline"}';
    }

    location @prolog_offline {
        default_type application/json;
        return 503 '{"error":"Prolog AI offline","status":"offline"}';
    }
}
